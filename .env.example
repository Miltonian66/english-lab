# Скопируй в .env и заполни реальными значениями. .env исключён из Git.

# ── обязательное ─────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=replace-with-botfather-token
# Секрет первого запуска: тот, кто пришлёт /start <код>, становится владельцем.
BOT_CLAIM_CODE=generate-a-long-random-value

# ── переключатель текста ─────────────────────────────────────────
# codex     — через подписку ChatGPT, без ключа и без денег, ~10 с на ответ
# claude    — через подписку Claude, без ключа и без денег, ~5–8 с на ответ
# openai    — Responses API, быстро, по токенам
# anthropic — Messages API, быстро, по токенам
LLM_PROVIDER=claude

# Только для LLM_PROVIDER=codex
CODEX_BINARY=codex
CODEX_MODEL=
CODEX_EFFORT=low
CODEX_TIMEOUT=180

# Только для LLM_PROVIDER=claude. Модель — алиас (sonnet, opus, fable) или полное
# имя; пусто — модель по умолчанию у залогиненной учётки.
CLAUDE_BINARY=claude
CLAUDE_MODEL=sonnet
CLAUDE_EFFORT=low
CLAUDE_TIMEOUT=180

# Только для LLM_PROVIDER=openai / anthropic
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# ── переключатель речи ───────────────────────────────────────────
# local  — faster-whisper и piper из .venv, бесплатно и офлайн
# openai — Whisper и синтез по API, нужен OPENAI_API_KEY
SPEECH_BACKEND=local

# Только для SPEECH_BACKEND=local
MODELS_DIR=data/models
WHISPER_MODEL=small.en
WHISPER_COMPUTE=int8
WHISPER_THREADS=3
PIPER_VOICE=en_US-lessac-medium

# Только для SPEECH_BACKEND=openai
STT_MODEL=whisper-1
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=alloy

# ── платформа ────────────────────────────────────────────────────
# Одновременные пользователи. Быстрые обновления одного чата обрабатываются
# строго по порядку; результат фоновой задачи приходит отдельно и может обогнать
# ответ на то, что человек нажал позже.
WORKERS=16
# Длинные цепочки (расшифровка, разбор, синтез) идут вне дорожки обновлений: по
# одной задаче на человека. 0 — выполнять их прямо в дорожке, как до разделения.
JOB_WORKERS=4
# Сторож: задача, идущая дольше, снимается, чтобы не запереть слот человека.
JOB_TIMEOUT=900
# Тяжёлые контуры изолированы. Для локального Whisper больше одного worker на
# этой машине замедляет все расшифровки из-за конкуренции за CPU.
LLM_WORKERS=2
STT_WORKERS=1
TTS_WORKERS=1
MAX_VOICE_SECONDS=300
DAILY_AI_CALLS=120
TEAM_OPEN_REGISTRATION=0

# ── данные ───────────────────────────────────────────────────────
DATABASE_PATH=data/english_bot.sqlite3
EXPORT_DIR=data/exports
VOICE_DIR=data/voices
AUDIO_CACHE_DIR=data/audio
LOG_LEVEL=INFO
