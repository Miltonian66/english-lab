[Unit]
Description=English Lab — многопользовательская платформа изучения английского
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/milton/english
EnvironmentFile=/home/milton/english/.env
# Python из .venv: там faster-whisper и piper для локальной речи. С системным
# python3 бот тоже запустится, но голос будет выключен.
ExecStart=/home/milton/english/.venv/bin/python -m english_bot
Restart=on-failure
RestartSec=5
UMask=0077
# Контент и runtime ~81 МБ, с piper и whisper small.en замер пика — 914 МиБ.
MemoryMax=1600M
# Подписочный провайдер (codex exec или claude -p) запускается подпроцессом и
# держит собственную сессию. Остановка их не ждёт: фоновые задачи снимаются, их
# результат теряется — один вызов CLI живёт дольше всего этого таймаута.
TimeoutStopSec=30

[Install]
WantedBy=default.target
